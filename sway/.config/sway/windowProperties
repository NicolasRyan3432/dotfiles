# Configurações de propriedades de janelas

for_window [app_id="org.pulseaudio.pavucontrol"] floating enable, resize set 750 600, move position 800 -2, border none
for_window [app_id="org.kde.dolphin"] border none
for_window [app_id="blueman-manager"] floating enable, resize set 550 500, move position 988 -2, border none
for_window [app_id="brave-browser"] border none
for_window [app_id="spotify"] border none

